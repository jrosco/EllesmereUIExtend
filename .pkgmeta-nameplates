package-as: EllesmereUIExtendNameplates

move-folders:
  EllesmereUIExtendNameplates/Core: EllesmereUIExtendNameplates/Nameplates/Shared
  EllesmereUIExtendNameplates/Nameplates: EllesmereUIExtendNameplates

ignore:
  - .agents
  - .github
  - .gitignore
  - .pkgmeta-nameplates
  - .pkgmeta-questtracker
  - .pkgmeta-bags
  - Bags
  - AGENTS.md
  - README.md
  - TESTING.md
  - QuestTracker
  - tools
  - docs
  - dist
  - Core/tests
  - Nameplates/tests
  - Nameplates/TargetLayers.lua

manual-changelog:
  filename: docs/NAMEPLATES-CHANGELOG.md
  markup-type: markdown

optional-dependencies:
  - ellesmereui
  - eui-nameplates
